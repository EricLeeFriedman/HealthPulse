<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="HealthPulse.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:HealthPulse.Views"
       Shell.BackgroundColor="#0F766E"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarForegroundColor="#0F766E"
       Shell.TabBarTitleColor="#0F766E"
       Shell.TabBarUnselectedColor="#6B7280">
    <TabBar>
        <ShellContent Title="Today" Route="today"
                      ContentTemplate="{DataTemplate views:TodayPage}" />
        <ShellContent Title="Migraines" Route="migraines"
                      ContentTemplate="{DataTemplate views:MigrainesPage}" />
        <ShellContent Title="Fitness" Route="fitness"
                      ContentTemplate="{DataTemplate views:FitnessPage}" />
        <ShellContent Title="Health" Route="health"
                      ContentTemplate="{DataTemplate views:HealthPage}" />
    </TabBar>
</Shell>
