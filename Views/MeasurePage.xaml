<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HealthPulse.ViewModels"
             xmlns:services="clr-namespace:HealthPulse.Services"
             x:Class="HealthPulse.Views.MeasurePage"
             x:DataType="vm:MeasureViewModel"
             Title="Measure"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16,12,16,24">

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsEditing}" BackgroundColor="#ECFDF5" Stroke="#6EE7B7">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding EditingText}" FontSize="14" TextColor="#065F46" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Waist and weight (weekly)" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding Date}" Format="ddd MMM d" />
                    </Grid>
                    <Label Text="Morning, before eating. Tape level at the navel, breathe out normally, measure twice and use the average."
                           Style="{StaticResource Muted}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Entry Text="{Binding Waist}" Keyboard="Numeric" Placeholder="Waist (in)" />
                        <Entry Grid.Column="1" Text="{Binding Weight}" Keyboard="Numeric" Placeholder="Weight (lb)" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Progress photos (monthly, optional)" Style="{StaticResource CardTitle}" />
                    <Label Text="Front, side and back. Same spot, light and time of day. Photos stay on this phone and are never uploaded."
                           Style="{StaticResource Muted}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="📷  Take photo" Style="{StaticResource SecondaryButton}" Command="{Binding TakePhotoCommand}" />
                        <Button Grid.Column="1" Text="🖼  Choose photo" Style="{StaticResource SecondaryButton}" Command="{Binding ChoosePhotoCommand}" />
                    </Grid>
                    <Label Text="{Binding PhotoText}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Monthly fitness test" Style="{StaticResource CardTitle}" />
                    <Label Text="Toe touch: legs straight, reach down slowly. Inches short of your toes as a negative number, 0 if you touch, positive if you reach past."
                           Style="{StaticResource Muted}" />
                    <Entry Text="{Binding ToeTouch}" Keyboard="Text" Placeholder="Toe touch (in), e.g. -3" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Entry Text="{Binding PushUps}" Keyboard="Numeric" Placeholder="Push-ups" />
                        <Entry Grid.Column="1" Text="{Binding Plank}" Keyboard="Numeric" Placeholder="Plank (s)" />
                    </Grid>
                    <Entry Text="{Binding Notes}" Placeholder="Notes (optional)" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Past entries" Style="{StaticResource CardTitle}" />
                    <Label Text="Tap one to edit or delete it." Style="{StaticResource Muted}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding History}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="services:MeasureHistoryItem">
                                <Label Text="{Binding Display}" FontSize="14" TextColor="#374151" Padding="0,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MeasureViewModel}}, Path=HistoryTappedCommand, x:DataType=vm:MeasureViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
