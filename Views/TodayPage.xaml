<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HealthPulse.ViewModels"
             xmlns:models="clr-namespace:HealthPulse.Models"
             xmlns:services="clr-namespace:HealthPulse.Services"
             x:Class="HealthPulse.Views.TodayPage"
             x:DataType="vm:TodayViewModel"
             Title="Today"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16,12,16,24">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Daily check-in" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding Date}" Format="ddd MMM d" />
                    </Grid>
                    <Label Text="{Binding PlanText}" FontSize="14" FontAttributes="Bold" TextColor="#0F766E" />
                    <Label Text="{Binding TargetText}" Style="{StaticResource Muted}" />
                    <Button Text="{Binding WorkoutGuideButtonText}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleWorkoutGuideCommand}" IsVisible="{Binding HasWorkoutGuide}" />
                    <Label Text="{Binding WorkoutGuideText}" IsVisible="{Binding ShowWorkoutGuide}"
                           FontSize="14" TextColor="#374151" LineHeight="1.3" />
                    <Button Text="{Binding AlternativesButtonText}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleAlternativesCommand}" IsVisible="{Binding HasAlternativesSection}" />
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowAlternatives}">
                        <Label Text="{Binding AlternativesIntro}" Style="{StaticResource Muted}" IsVisible="{Binding HasAlternatives}" />
                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Alternatives}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlternativeItem">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="{Binding HowButtonText}" Style="{StaticResource SecondaryButton}"
                                                    Padding="12,4" Command="{Binding ToggleHowCommand}" />
                                            <Button Grid.Column="2" Text="Log" Style="{StaticResource SecondaryButton}" Padding="12,4"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodayViewModel}}, Path=LogAlternativeCommand, x:DataType=vm:TodayViewModel}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                        <Label Text="{Binding How}" IsVisible="{Binding ShowHow}"
                                               FontSize="14" TextColor="#374151" LineHeight="1.3" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="Or swap with another day this week" Style="{StaticResource Muted}" IsVisible="{Binding CanSwap}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanSwap}">
                            <Picker ItemsSource="{Binding SwapOptions}" SelectedIndex="{Binding SwapIndex}" Title="Pick a day" />
                            <Button Grid.Column="1" Text="Swap" Style="{StaticResource SecondaryButton}" Command="{Binding SwapCommand}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsSwapped}">
                            <Label Text="{Binding SwapNoteText}" FontSize="14" TextColor="#374151" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Undo swap" Style="{StaticResource SecondaryButton}" Command="{Binding UndoSwapCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                    <Label Text="{Binding WeatherText}" FontSize="14" TextColor="#374151" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Reminders" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding RemindersOn}" OnColor="#0F766E" />
                    </Grid>
                    <Label Text="{Binding ReminderText}" Style="{StaticResource Muted}" />
                    <Label Text="{Binding OpenTasksText}" FontSize="14" TextColor="#374151" />
                    <Button Text="Stop reminders for today" Style="{StaticResource SecondaryButton}"
                            Command="{Binding StopRemindersTodayCommand}" IsVisible="{Binding CanStopToday}" />
                    <Button Text="Turn today's reminders back on" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResumeRemindersTodayCommand}" IsVisible="{Binding CanResumeToday}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Caffeine and food" Style="{StaticResource CardTitle}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding CaffeineText}" VerticalOptions="Center" FontSize="15" />
                        <Stepper Grid.Column="1" Minimum="0" Maximum="20" Increment="1" Value="{Binding CaffeineCups}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding HasLastCaffeine}" Color="#0F766E" />
                        <Label Grid.Column="1" Text="Last caffeine at" VerticalOptions="Center" />
                        <TimePicker Grid.Column="2" Time="{Binding LastCaffeineTime}" IsEnabled="{Binding HasLastCaffeine}" />
                        <Button Grid.Column="3" Text="Now" Style="{StaticResource SecondaryButton}" Command="{Binding CaffeineTimeNowCommand}" />
                    </Grid>
                    <Button Text="☕  Had a coffee just now" Style="{StaticResource SecondaryButton}" Command="{Binding CaffeineNowCommand}" />

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                        <CheckBox IsChecked="{Binding HasFirstMeal}" Color="#0F766E" />
                        <Label Grid.Column="1" Text="First meal at" VerticalOptions="Center" />
                        <TimePicker Grid.Column="2" Time="{Binding FirstMealTime}" IsEnabled="{Binding HasFirstMeal}" />
                        <Button Grid.Column="3" Text="Now" Style="{StaticResource SecondaryButton}" Command="{Binding MealTimeNowCommand}" />
                    </Grid>
                    <Button Text="🍳  Ate my first meal just now" Style="{StaticResource SecondaryButton}" Command="{Binding MealNowCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Food log" Style="{StaticResource CardTitle}" />
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasFrequentFoods}">
                        <Label Text="Frequent foods (tap to fill in, then Add)" Style="{StaticResource Muted}" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding FrequentFoodsList}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="services:FrequentFood">
                                    <Button Text="{Binding Display}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodayViewModel}}, Path=PickFrequentFoodCommand, x:DataType=vm:TodayViewModel}"
                                            CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                    <Editor Text="{Binding NewFoodText}" Placeholder="What did you eat? e.g. 3 eggs, 1 slice toast, big latte" AutoSize="TextChanges" MaxLength="500" />
                    <Label Text="No exact amounts? Pick a rough portion, tick what's in it, or add a photo. It all goes in the export." Style="{StaticResource Muted}" />
                    <Picker Title="Portion (optional)" ItemsSource="{Binding PortionChoices}" SelectedItem="{Binding NewFoodPortion}" />
                    <Label Text="What's in it (tap all that apply)" Style="{StaticResource Muted}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding IngredientChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:IngredientChip">
                                <Button Text="{Binding Text}" Margin="0,0,6,6"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodayViewModel}}, Path=ToggleIngredientCommand, x:DataType=vm:TodayViewModel}"
                                        CommandParameter="{Binding .}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="HeightRequest" Value="38" />
                                            <Setter Property="Padding" Value="12,0" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="BackgroundColor" Value="#F3F4F6" />
                                            <Setter Property="TextColor" Value="#374151" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#0F766E" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding CustomIngredient}" Placeholder="Something else, e.g. ham" MaxLength="40"
                               ReturnCommand="{Binding AddCustomIngredientCommand}" />
                        <Button Grid.Column="1" Text="+ Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddCustomIngredientCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="📷  Photo" Style="{StaticResource SecondaryButton}" Command="{Binding TakeFoodPhotoCommand}" />
                        <Button Grid.Column="1" Text="🖼  Choose" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseFoodPhotoCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasNewFoodPhoto}">
                        <Image Source="{Binding NewFoodPhoto}" HeightRequest="72" WidthRequest="72" Aspect="AspectFill" />
                        <Label Grid.Column="1" Text="Photo attached. It's copied to your Drive with the next export." Style="{StaticResource Muted}" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="Remove" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveFoodPhotoCommand}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <TimePicker Time="{Binding NewFoodTime}" />
                        <Button Grid.Column="1" Text="Now" Style="{StaticResource SecondaryButton}" Command="{Binding FoodTimeNowCommand}" />
                        <Button Grid.Column="2" Text="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelFoodEditCommand}" IsVisible="{Binding IsEditingFood}" />
                        <Button Grid.Column="3" Text="{Binding FoodButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding AddFoodCommand}" />
                    </Grid>
                    <Label Text="{Binding MealsSummary}" Style="{StaticResource Muted}" />
                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Meals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:FoodEntry">
                                <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodayViewModel}}, Path=FoodTappedCommand, x:DataType=vm:TodayViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding DisplayTime}" FontAttributes="Bold" TextColor="#0F766E" />
                                    <Label Grid.Column="1" Text="{Binding Display}" TextColor="#374151" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Water, alcohol, stress" Style="{StaticResource CardTitle}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding WaterText}" VerticalOptions="Center" FontSize="15" />
                        <Label Grid.Column="1" Text="{Binding WaterStatus}" VerticalOptions="Center" Style="{StaticResource Muted}" />
                    </Grid>
                    <ProgressBar Progress="{Binding WaterProgress}" ProgressColor="#0F766E" />
                    <Label Text="Tap to add (saves right away)" Style="{StaticResource Muted}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding WaterAmounts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="services:WaterAmount">
                                <Button Text="{Binding Label}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodayViewModel}}, Path=AddWaterAmountCommand, x:DataType=vm:TodayViewModel}"
                                        CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding CustomWaterOunces}" Placeholder="Other amount (oz)" Keyboard="Numeric" />
                        <Button Grid.Column="1" Text="Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddCustomWaterCommand}" />
                        <Button Grid.Column="2" Text="Remove" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveCustomWaterCommand}" />
                        <Button Grid.Column="3" Text="Undo" Style="{StaticResource SecondaryButton}" Command="{Binding UndoWaterCommand}"
                                IsVisible="{Binding CanUndoWater}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding AlcoholText}" VerticalOptions="Center" FontSize="15" />
                        <Stepper Grid.Column="1" Minimum="0" Maximum="20" Increment="1" Value="{Binding AlcoholDrinks}" />
                    </Grid>
                    <Label Text="Stress today" Style="{StaticResource Muted}" />
                    <Picker ItemsSource="{Binding StressOptions}" SelectedIndex="{Binding StressIndex}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Supplements" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="All taken" Style="{StaticResource SecondaryButton}" Command="{Binding AllSupplementsCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="4">
                        <CheckBox IsChecked="{Binding Riboflavin}" Color="#0F766E" />
                        <Label Grid.Column="1" Text="Riboflavin" VerticalOptions="Center" />
                        <CheckBox Grid.Column="2" IsChecked="{Binding BComplex}" Color="#0F766E" />
                        <Label Grid.Column="3" Text="B complex" VerticalOptions="Center" />
                        <CheckBox Grid.Row="1" IsChecked="{Binding CoQ10}" Color="#0F766E" />
                        <Label Grid.Row="1" Grid.Column="1" Text="CoQ10" VerticalOptions="Center" />
                        <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding Magnesium}" Color="#0F766E" />
                        <Label Grid.Row="1" Grid.Column="3" Text="Magnesium" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox IsChecked="{Binding MobilityDone}" Color="#0F766E" />
                        <Label Grid.Column="1" Text="{Binding MobilityLabel}" VerticalOptions="Center" FontSize="15" />
                        <Button Grid.Column="2" Text="{Binding MobilityButtonText}" Style="{StaticResource SecondaryButton}"
                                Padding="12,4" Command="{Binding ToggleMobilityRoutineCommand}" />
                    </Grid>
                    <Label Text="{Binding MobilityRoutineText}" IsVisible="{Binding ShowMobilityRoutine}"
                           FontSize="14" TextColor="#374151" LineHeight="1.3" />
                    <Entry Text="{Binding Notes}" Placeholder="Notes (optional)" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Save check-in" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
            <Label Text="{Binding SavedText}" Style="{StaticResource Muted}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
