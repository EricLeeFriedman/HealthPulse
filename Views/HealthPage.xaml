<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HealthPulse.ViewModels"
             xmlns:models="clr-namespace:HealthPulse.Models"
             x:Class="HealthPulse.Views.HealthPage"
             x:DataType="vm:HealthViewModel"
             Title="Health"
             BackgroundColor="#F3F4F6">

    <CollectionView ItemsSource="{Binding Days}" SelectionMode="None" Margin="16,0">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="12" Padding="0,12,0,8">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Health Connect" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding ConnectionStatus}" FontSize="14" TextColor="#374151" />
                        <Button Text="Connect" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Google Drive export" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding DriveText}" FontSize="14" TextColor="#374151" />
                        <Label Text="{Binding ExportStatus}" Style="{StaticResource Muted}" />
                        <Label Text="{Binding ProgressText}" FontSize="14" TextColor="#0F766E" />
                        <Button Text="Sign in with Google" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SignInCommand}" IsVisible="{Binding IsSignedOut}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding IsSignedIn}">
                            <Button Text="Export now" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ExportNowCommand}" />
                            <Button Grid.Column="1" Text="Share…" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ShareExportCommand}" />
                        </Grid>
                        <Button Text="Sign out of Google" BackgroundColor="Transparent" TextColor="#6B7280"
                                Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasErrors}"
                        BackgroundColor="#FEF2F2" Stroke="#FCA5A5">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Recent problems" Style="{StaticResource CardTitle}" />
                        <Label Text="These are also included in the Drive export so they can be diagnosed."
                               Style="{StaticResource Muted}" />
                        <Label Text="{Binding ErrorText}" FontSize="12" TextColor="#7F1D1D" />
                        <Button Text="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearErrorsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0F766E" />
                <Label Text="Last 14 days" Style="{StaticResource CardTitle}" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:DailyHealthSummary">
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding DisplayDate}" FontAttributes="Bold" TextColor="#0F766E" />
                        <Label Text="{Binding Display}" FontSize="14" TextColor="#374151" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
